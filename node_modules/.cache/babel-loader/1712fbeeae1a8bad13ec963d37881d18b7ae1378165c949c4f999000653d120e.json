<form @submit.prevent=\"handleSubmit\">\n      <div class=\"input-container\">\n        <input\n          type=\"text\"\n          v-model=\"newMessage\"\n          placeholder=\"输入你的留言\"\n        />\n        <button type=\"submit\">提交</button>\n      </div>\n    </form>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      messages: [], // 存储留言的数组\n      newMessage: '' // 当前输入的留言\n    };\n  },\n  methods: {\n    handleSubmit() {\n      if (!this.newMessage) return; // 如果留言为空，直接返回\n\n      this.messages.push({ text: this.newMessage, showCommentInput: false, comment: '' }); // 将新留言添加到数组中\n      this.newMessage = ''; // 清空输入框\n    },\n    toggleCommentInput(index) {\n      this.messages[index].showCommentInput = !this.messages[index].showCommentInput; // 切换评论输入框的显示状态\n    },\n    submitComment(index) {\n      // 提交评论的逻辑，可以根据需要进行处理\n      console.log(`评论: ${this.messages[index].comment}`);\n      this.messages[index].comment = ''; // 清空评论输入框\n      this.messages[index].showCommentInput = false; // 隐藏评论输入框\n    }\n  }\n};\n</script>\n\n<style scoped>\nhtml, body {\n  height: 100%; /* 确保 html 和 body 高度为 100% */\n  margin: 0; /* 去掉默认的 margin */\n  padding: 0; /* 去掉默认的 padding */\n  overflow: hidden; /* 禁止 body 滚动，避免白边 */\n}\n\n.message-board {\n  background-image: url('@/assets/back.png'); /* 替换为你的背景图片路径 */\n  background-size: cover;\n  background-position: center;\n  background-attachment: fixed; /* 背景固定，不随内容滚动 */\n  height: 100vh; /* 设置高度为 100vh，确保铺满整个屏幕 */\n  width: 100vw; /* 设置宽度为 100vw，确保铺满整个视口 */\n  display: flex;\n  flex-direction: column; /* 使子元素垂直排列 */\n  justify-content: flex-end; /* 将内容推到底部 */\n  padding: 2vh 2vw; /* 使用视口单位设置内边距 */\n  color: white; /* 文字颜色 */\n  max-width: 100%; /* 设置最大宽度为 100% */\n  margin: 0; /* 去掉默认的 margin */\n  box-sizing: border-box; /* 确保padding不会增加元素的总宽高 */\n  position: fixed; /* 固定定位，防止滚动出现白边 */\n  top: 0;\n  left: 0;\n}\n\nform {\n  margin-top: 20px; /* 输入框与留言记录之间的间距 */\n}\n\n.input-container {\n  display: flex; /* 使用 flexbox 布局 */\n  justify-content: center; /* 水平居中 */\n  width: 100%; /* 宽度为 100% */\n  max-width: 100%; /* 确保不超出父容器 */\n}\n\ninput {\n  padding: 2vh; /* 使用视口单位增大输入框的内边距 */\n  border: none;\n  border-radius: 5px;\n  margin-right: 1vw; /* 使用视口单位设置右边距 */\n  flex: 1; /* 使输入框占据剩余空间 */\n  max-width: 70%; /* 调整最大宽度 */\n}\n\nbutton {\n  padding: 2vh 3vw; /* 使用视口单位增大按钮的内边距 */\n  border: none;\n  border-radius: 5px;\n  background-color: #007bff;\n  color: white;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background-color: #0056b3;\n}\n\nul {\n  list-style-type: none;\n  padding: 0;\n  margin: 0; /* 去掉默认的 margin */\n  flex-grow: 1; /* 使留言记录占据剩余空间 */\n  overflow-y: auto; /* 允许滚动 */\n  -webkit-overflow-scrolling: touch; /* 使滚动在移动设备上更流畅 */\n  width: 100%; /* 确保宽度与父容器一致 */\n  display: flex;\n  flex-direction: column;\n  align-items: center; /* 水平居中列表项 */\n}\n\nli {\n  background: rgba(255, 255, 255, 0.8);\n  margin: 5px 0;\n  padding: 10px;\n  border-radius: 5px;\n  color: #333; /* 改善文字可读性 */\n  width: 70%; /* 与输入框宽度保持一致 */\n  box-sizing: border-box; /* 确保padding不会增加元素总宽度 */\n}\n\n.message-content {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  width: 100%;\n}\n\n.message-text {\n  text-align: left;\n  flex: 1;\n  word-break: break-word;\n}\n\n.icon-button {\n  background: none;\n  border: none;\n  padding: 5px;\n  cursor: pointer;\n  margin-left: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.comment-icon {\n  font-style: normal;\n  font-size: 1.2rem;\n}\n\n/* 确保评论输入区域也对齐 */\n.comment-input {\n  width: 100%;\n  margin-top: 8px;\n  display: flex;\n}\n\nli div input {\n  width: calc(100% - 80px); /* 为提交按钮留出空间 */\n  margin-right: 8px;\n  max-width: none; /* 覆盖父级的max-width限制 */\n}\n</style> "],"mappings":";;EACOA,KAAK,EAAC;AAAe;;EAGfA,KAAK,EAAC;AAAiB;;EACpBA,KAAK,EAAC;AAAc;mBALpC;;EAAAC,GAAA;EAUyCD,KAAK,EAAC;;mBAV/C;mBAAA;;EAqBWA,KAAK,EAAC;AAAiB;;uBApBhCE,mBAAA,CA6BM,OA7BNC,UA6BM,GA5BJC,mBAAA,CAiBK