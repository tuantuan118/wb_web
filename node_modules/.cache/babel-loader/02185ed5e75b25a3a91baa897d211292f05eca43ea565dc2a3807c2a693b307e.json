{"ast":null,"code":"import axios from 'axios';\nexport default {\n  data() {\n    return {\n      messages: [],\n      newMessage: ''\n    };\n  },\n  created() {\n    this.fetchMessages();\n  },\n  methods: {\n    async fetchMessages() {\n      const response = await axios.get('/api/messages');\n      this.messages = response.data;\n    },\n    async handleSubmit() {\n      if (!this.newMessage) return;\n      await axios.post('/api/messages', {\n        content: this.newMessage\n      });\n      this.newMessage = '';\n      this.fetchMessages();\n    }\n  }\n};","map":{"version":3,"names":["axios","data","messages","newMessage","created","fetchMessages","methods","response","get","handleSubmit","post","content"],"sources":["/Users/tt/html/wb_web/src/components/MessageBoard.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>留言板</h1>\n    <form @submit.prevent=\"handleSubmit\">\n      <input\n        type=\"text\"\n        v-model=\"newMessage\"\n        placeholder=\"输入你的留言\"\n      />\n      <button type=\"submit\">提交</button>\n    </form>\n    <ul>\n      <li v-for=\"(msg, index) in messages\" :key=\"index\">{{ msg.content }}</li>\n    </ul>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  data() {\n    return {\n      messages: [],\n      newMessage: ''\n    };\n  },\n  created() {\n    this.fetchMessages();\n  },\n  methods: {\n    async fetchMessages() {\n      const response = await axios.get('/api/messages');\n      this.messages = response.data;\n    },\n    async handleSubmit() {\n      if (!this.newMessage) return;\n\n      await axios.post('/api/messages', { content: this.newMessage });\n      this.newMessage = '';\n      this.fetchMessages();\n    }\n  }\n};\n</script>\n\n<style scoped>\n/* 这里可以添加样式 */\n</style> "],"mappings":"AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,aAAa,CAAC,CAAC;EACtB,CAAC