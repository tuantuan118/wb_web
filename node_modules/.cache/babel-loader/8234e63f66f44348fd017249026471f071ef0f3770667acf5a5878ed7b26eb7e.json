kground-color: #0056b3;\n}\n\nul {\n  list-style-type: none;\n  padding: 0;\n  margin: 0; /* 去掉默认的 margin */\n  flex-grow: 1; /* 使留言记录占据剩余空间 */\n  overflow-y: auto; /* 允许滚动 */\n  -webkit-overflow-scrolling: touch; /* 使滚动在移动设备上更流畅 */\n  width: 100%; /* 确保宽度与父容器一致 */\n}\n\nli {\n  background: rgba(255, 255, 255, 0.8);\n  margin: 5px 0;\n  padding: 10px;\n  border-radius: 5px;\n  color: #333; /* 改善文字可读性 */\n  width: calc(100% - 20px); /* 考虑padding后的宽度 */\n  box-sizing: border-box; /* 确保padding不会增加元素总宽度 */\n}\n</style> "],"mappings":";;EACOA,KAAK,EAAC;AAAe;mBAD5B;;EAAAC,GAAA;AAAA;mBAAA;mBAAA;;EAiBWD,KAAK,EAAC;AAAiB;;uBAhBhCE,mBAAA,CAyBM,OAzBNC,UAyBM,GAxBJC,mBAAA,CAaK,c,kBAZHF,mBAAA,CAWKG,SAAA,QAdXC,WAAA,CAGiCC,KAAA,CAAAC,QAAQ,EAHzC,CAGkBC,GAAG,EAAEC,KAAK;yBAAtBR,mBAAA,CAWK;MAXiCD,GAAG,EAAES;IAAK,IAHtDC,gBAAA,CAAAC,gBAAA,CAIWH,GAAG,CAACI,IAAI,IAAG,GACd,iBAAAT,mBAAA,CAAsD;MAA7CU,OAAK,EAAAC,MAAA,IAAEC,QAAA,CAAAC,kBAAkB,CAACP,KAAK;OAAG,IAAE,iBALrDQ,UAAA,GAMmBT,GAAG,CAACU,gBAAgB,I,cAA/BjB,mBAAA,CAOM,OAbdkB,UAAA,G,gBAOUhB,mBAAA,CAIE;MAHAiB,IAAI,EAAC,MAAM;MARvB,uBAAAN,MAAA,IASqBN,GAAG,CAACa,OAAO,GAAAP,MAAA;MACpBQ,WAAW,EAAC;4BAVxBC,UAAA,I,cASqBf,GAAG,CAACa,OAAO,E,GAGtBlB,mBAAA,CAAmD;MAA1CU,OAAK,EAAAC,MAAA,IAAEC,QAAA,CAAAS,aAAa,CAACf,KAAK;OAAG,MAAI,iBAZpDgB,UAAA,E,KAAAC,mBAAA,e;oCAgBIvB,mBAAA,CASO;IATAwB,QAAM,EAAAC,MAAA,QAAAA,MAAA,MAhBjBC,cAAA,KAAAC,IAAA,KAgB2Bf,QAAA,CAAAgB,YAAA,IAAAhB,QAAA,CAAAgB,YAAA,IAAAD,IAAA,CAAY;MACjC3B,mBAAA,CAOM,OAPN6B,UAOM,G,gBANJ7B,mBAAA,CAIE;IAHAiB,IAAI,EAAC,MAAM;IAnBrB,uBAAAQ,MAAA,QAAAA,MAAA,MAAAd,MAAA,IAoBmBR,KAAA,CAAA2B,UAAU,GAAAnB,MAAA;IACnBQ,WAAW,EAAC;iDADHhB,KAAA,CAAA2B,UAAU,E,6BAGrB9B,mBAAA,CAAiC;IAAzBiB,IAAI,EAAC;EAAQ,GAAC,IAAE,qB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}