{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      messages: [],\n      newMessage: ''\n    };\n  },\n  created() {\n    this.fetchMessages();\n  },\n  methods: {\n    async fetchMessages() {\n      const response = await axios.get('/api/messages');\n      this.messages = response.data;\n    },\n    async handleSubmit() {\n      if (!this.newMessage) return;\n      await axios.post('/api/messages', {\n        content: this.newMessage\n      });\n      this.messages.push({\n        content: this.newMessage\n      });\n      this.newMessage = '';\n    }\n  }\n};","map":{"version":3,"names":["axios","data","messages","newMessage","created","fetchMessages","methods","response","get","handleSubmit","post","content","push"],"sources":["/Users/tt/html/wb_web/src/components/MessageBoard.vue"],"sourcesContent":["<template>\n  <div class=\"message-board\">\n    <h1>留言板</h1>\n    <form @submit.prevent=\"handleSubmit\">\n      <input\n        type=\"text\"\n        v-model=\"newMessage\"\n        placeholder=\"输入你的留言\"\n      />\n      <button type=\"submit\">提交</button>\n    </form>\n    <ul>\n      <li v-for=\"(msg, index) in messages\" :key=\"index\">{{ msg.content }}</li>\n    </ul>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  data() {\n    return {\n      messages: [],\n      newMessage: ''\n    };\n  },\n  created() {\n    this.fetchMessages();\n  },\n  methods: {\n    async fetchMessages() {\n      const response = await axios.get('/api/messages');\n      this.messages = response.data;\n    },\n    async handleSubmit() {\n      if (!this.newMessage) return;\n\n      await axios.post('/api/messages', { content: this.newMessage });\n      this.messages.push({ content: this.newMessage });\n      this.newMessage = '';\n    }\n  }\n};\n</script>\n\n<style scoped>\n.message-board {\n  background-image: url('@/assets/back.png'); /* 替换为你的背景图片路径 */