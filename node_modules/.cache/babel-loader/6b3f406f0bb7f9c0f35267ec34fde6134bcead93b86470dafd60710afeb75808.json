ssages\" :key=\"index\">{{ msg }}</li>\n    </ul>\n    <form @submit.prevent=\"handleSubmit\">\n      <div class=\"input-container\">\n        <input\n          type=\"text\"\n          v-model=\"newMessage\"\n          placeholder=\"输入你的留言\"\n        />\n        <button type=\"submit\">提交</button>\n      </div>\n    </form>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      messages: [], // 存储留言的数组\n      newMessage: '' // 当前输入的留言\n    };\n  },\n  methods: {\n    handleSubmit() {\n      if (!this.newMessage) return; // 如果留言为空，直接返回\n\n      this.messages.push(this.newMessage); // 将新留言添加到数组中\n      this.newMessage = ''; // 清空输入框\n    }\n  }\n};\n</script>\n\n<style scoped>\nhtml, body {\n  height: 100%; /* 确保 html 和 body 高度为 100% */\n  margin: 0; /* 去掉默认的 margin */\n  padding: 0; /* 去掉默认的 padding */\n  overflow: hidden; /* 禁止 body 滚动，避免白边 */\n}\n\n.message-board {\n  background-image: url('@/assets/back.png'); /* 替换为你的背景图片路径 */\n  background-size: cover;\n  background-position: center;\n  background-attachment: fixed; /* 背景固定，不随内容滚动 */\n  height: 100vh; /* 设置高度为 100vh，确保铺满整个屏幕 */\n  width: 100vw; /* 设置宽度为 100vw，确保铺满整个视口 */\n  display: flex;\n  flex-direction: column; /* 使子元素垂直排列 */\n  justify-content: flex-end; /* 将内容推到底部 */\n  padding: 2vh 2vw; /* 使用视口单位设置内边距 */\n  color: white; /* 文字颜色 */\n  max-width: 100%; /* 设置最大宽度为 100% */\n  margin: 0; /* 去掉默认的 margin */\n}\n\nform {\n  margin-top: 20px; /* 输入框与留言记录之间的间距 */\n}\n\n.input-container {\n  display: flex; /* 使用 flexbox 布局 */\n  justify-content: center; /* 水平居中 */\n  width: 100%; /* 宽度为 100% */\n}\n\ninput {\n  padding: 2vh; /* 使用视口单位增大输入框的内边距 */\n  border: none;\n  border-radius: 5px;\n  margin-right: 1vw; /* 使用视口单位设置右边距 */\n  flex: 1; /* 使输入框占据剩余空间 */\n  max-width: 50%; /* 最大宽度为屏幕的一半 */\n}\n\nbutton {\n  padding: 2vh 3vw; /* 使用视口单位增大按钮的内边距 */\n  border: none;\n  border-radius: 5px;\n  background-color: #007bff;\n  color: white;\n  cursor: pointer;\n}\n\nbutton:hover {\n  backgroun